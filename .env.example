# Local development only. Production must configure OIDC and TLS.
IVP_ENV=development
IVP_DEV_AUTH=1
IVP_DEV_TENANT_ID=11111111-1111-4111-8111-111111111111
IVP_DEV_USER_ID=22222222-2222-4222-8222-222222222222
IVP_DEV_SUBJECT=ivp-local-development
IVP_POSTGRES_PASSWORD=change-me-local-only
IVP_DATABASE_URL=postgres://ivp:change-me-local-only@postgres:5432/ivp?sslmode=disable
IVP_OIDC_ISSUER=
IVP_OIDC_AUDIENCE=
IVP_OIDC_CLIENT_ID=
IVP_LISTEN_ADDR=:8080
IVP_LOG_LEVEL=info
IVP_ARTIFACT_BACKEND=filesystem
IVP_ARTIFACT_DIR=/var/lib/ivp/artifacts
IVP_RAW_HISTORY_RETENTION_DAYS=90

