  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [{ "expr": "sum by (mode, outcome) (rate(ivp_plan_requests_total[5m]))", "legendFormat": "{{mode}} / {{outcome}}", "refId": "A" }],
      "title": "Plan requests per second",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [{ "expr": "sum by (reason_code) (rate(ivp_full_fallback_total[15m]))", "legendFormat": "{{reason_code}}", "refId": "A" }],
      "title": "Full verification fallback rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, adapter) (rate(ivp_execution_duration_seconds_bucket[15m])))", "legendFormat": "{{adapter}}", "refId": "A" }],
      "title": "Execution duration (p95)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [{ "expr": "sum by (severity, adapter) (increase(ivp_audit_misses_total[24h]))", "legendFormat": "{{severity}} / {{adapter}}", "refId": "A" }],
      "title": "Observed audit misses (24h)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "id": 5,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [{ "expr": "sum(rate(ivp_api_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(ivp_api_requests_total[5m])), 0.001)", "legendFormat": "5xx request ratio", "refId": "A" }],
      "title": "API server error ratio",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
