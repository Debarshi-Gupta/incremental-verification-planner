{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ivp.dev/schemas/ivp-config.schema.json",
  "title": "IVP repository configuration",
  "description": "Value constraints for the effective .ivp/config.yaml. Absent keys take product defaults (LLD 5.1 precedence layer 1); unknown keys are errors. Semantic rules (globs, argv safety, cross-field ordering) are enforced by config.Validate at load time.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "repository": {"type": "object", "additionalProperties": false, "properties": {"slug": {"type": "string", "pattern": "^(?:\\s*\\S.*)?$"}, "default_branch": {"type": "string"}}},
    "analysis": {"type": "object", "additionalProperties": false, "properties": {"base_ref": {"type": "string", "pattern": "^\\s*\\S.*$"}, "follow_renames": {"type": "boolean"}, "include_untracked": {"type": "boolean"}, "max_changed_files_for_selective_plan": {"type": "integer", "minimum": 1}, "graph_staleness_minutes": {"type": "integer", "minimum": 1}, "coverage_staleness_days": {"type": "integer", "minimum": 1}, "history_window_days": {"type": "integer", "minimum": 1, "maximum": 3650}, "flake_minimum_comparable_observations": {"type": "integer", "minimum": 1, "description": "Minimum number of comparable observations required before a test may be classified flaky (LLD 7.3); at least 1."}, "require_clean_dependency_resolution": {"const": true}}},
    "server": {"type": "object", "additionalProperties": false, "properties": {"endpoint": {"type": "string", "pattern": "^$|^https?://[^/?#@\\s]+(?:/[^\\s?#]*)?$"}, "connect_timeout_seconds": {"type": "integer", "minimum": 1}, "request_timeout_seconds": {"type": "integer", "minimum": 1}, "offline_policy": {"enum": ["FULL_SUITE_FALLBACK"]}}},
    "execution": {"type": "object", "additionalProperties": false, "properties": {"full_suite_argv": {"type": "array", "items": {"type": "string", "minLength": 1}}, "timeout_seconds": {"type": "integer", "minimum": 1}, "max_output_bytes": {"type": "integer", "minimum": 1024, "maximum": 67108864}, "failure_retry_count": {"type": "integer", "minimum": 0, "maximum": 3}}},
    "modes": {"type": "object", "additionalProperties": false, "properties": {"default": {"enum": ["FULL", "OBSERVE", "FAST_FEEDBACK", "RISK_BASED_CI"]}, "observe": {"type": "object", "additionalProperties": false, "properties": {"execute_full_suite": {"const": true}, "selected_plan_only_report": {"type": "boolean"}}}, "fast_feedback": {"type": "object", "additionalProperties": false, "properties": {"final_ci_full_suite_required": {"const": true}, "allow_selective_inner_loop": {"type": "boolean"}}}, "risk_based_ci": {"type": "object", "additionalProperties": false, "properties": {"enabled_by_organization_policy": {"type": "boolean"}, "audit_sample_rate": {"type": "number", "minimum": 0, "maximum": 1}, "minimum_calibration_runs": {"type": "integer", "minimum": 1}, "minimum_audit_runs": {"type": "integer", "minimum": 1}}}}},
    "selection": {"type": "object", "additionalProperties": false, "properties": {"low_risk_max_score": {"type": "integer", "minimum": 0, "maximum": 24}, "medium_risk_max_score": {"type": "integer", "minimum": 25, "maximum": 59}, "low_risk_min_weighted_coverage": {"type": "number", "minimum": 0.95, "maximum": 1}, "medium_risk_min_weighted_coverage": {"type": "number", "minimum": 0.99, "maximum": 1}, "minimum_selection_confidence": {"type": "number", "minimum": 0.98, "maximum": 1}, "max_selective_estimated_runtime_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.7}, "unknown_evidence_action": {"const": "FULL_SUITE"}, "non_deterministic_test_action": {"const": "INCLUDE_AND_LABEL"}, "if_no_tests_selected": {"const": "FULL_SUITE"}}},
    "safety": {"type": "object", "additionalProperties": false, "properties": {"hard_full_suite_paths": {"type": "array", "items": {"type": "string"}}, "hard_full_suite_risk_labels": {"type": "array", "items": {"type": "string", "pattern": "\\S"}}, "always_run_check_ids": {"type": "array", "items": {"type": "string", "pattern": "\\S"}}, "critical_path_patterns": {"type": "array", "items": {"type": "string"}}, "documentation_path_patterns": {"type": "array", "items": {"type": "string"}}, "reviewed_exclusions": {"type": "array", "items": {"$ref": "#/$defs/reviewedExclusion"}}, "hard_path_exceptions": {"type": "array", "items": {"$ref": "#/$defs/hardPathException"}}, "audit": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "default_mode": {"enum": ["SHADOW", "AUDIT"]}, "sample_rate": {"type": "number", "minimum": 0, "maximum": 1}, "minimum_audits_before_selective_ci": {"type": "integer", "minimum": 1}, "quarantine_on_confirmed_miss": {"const": true}, "quarantine_hours": {"type": "integer", "minimum": 1}, "repeat_failed_test_count": {"type": "integer", "minimum": 1}, "scheduled_cadence_hours": {"type": "integer", "minimum": 1, "maximum": 8760, "description": "Scheduled-audit cadence in hours: every active repository runs full verification at least this often (LLD 10.2)."}, "acknowledgement_sla_hours": {"type": "integer", "minimum": 1, "maximum": 8760, "description": "Response SLA in hours for an audit miss; a possible miss left unacknowledged past it alerts (LLD 15.3)."}}}}},
    "adapters": {"type": "object", "additionalProperties": false, "properties": {"gradle": {"$ref": "#/$defs/gradle"}, "maven": {"$ref": "#/$defs/maven"}, "bazel": {"$ref": "#/$defs/bazel"}, "nx": {"$ref": "#/$defs/nx"}, "pytest": {"$ref": "#/$defs/pytest"}, "jest": {"$ref": "#/$defs/jest"}, "generic": {"$ref": "#/$defs/generic"}}},
    "telemetry": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "capture_raw_stdout": {"const": false}, "capture_failure_excerpt": {"type": "boolean"}, "max_excerpt_bytes": {"type": "integer", "minimum": 0, "maximum": 1048576}, "retention_days": {"type": "integer", "minimum": 1}}}
  },
  "$defs": {
    "gradle": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "wrapper_required": {"type": "boolean"}, "unit_test_tasks": {"type": "array", "items": {"type": "string"}}, "integration_test_tasks": {"type": "array", "items": {"type": "string"}}, "coverage_paths": {"type": "array", "items": {"type": "string"}}}},
    "maven": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "wrapper_preferred": {"type": "boolean"}, "surefire_enabled": {"type": "boolean"}, "failsafe_enabled": {"type": "boolean"}, "coverage_paths": {"type": "array", "items": {"type": "string"}}}},
    "bazel": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "use_configured_target_patterns": {"type": "boolean"}, "coverage_paths": {"type": "array", "items": {"type": "string"}}}},
    "nx": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "test_target_names": {"type": "array", "items": {"type": "string"}}, "coverage_paths": {"type": "array", "items": {"type": "string"}}}},
    "pytest": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "config_file": {"type": "string"}, "coverage_paths": {"type": "array", "items": {"type": "string"}}}},
    "jest": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "config_discovery": {"type": "boolean"}, "coverage_paths": {"type": "array", "items": {"type": "string"}}}},
    "generic": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "test_units": {"type": "array", "items": {"$ref": "#/$defs/genericUnit"}}, "checks": {"type": "array", "items": {"$ref": "#/$defs/genericUnit"}}}},
    "genericUnit": {"type": "object", "additionalProperties": false, "properties": {"id": {"type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$"}, "display_name": {"type": "string"}, "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "cwd": {"type": "string"}, "maps_paths": {"type": "array", "items": {"type": "string", "minLength": 1}}, "depends_on": {"type": "array", "items": {"type": "string", "minLength": 1}}, "report_paths": {"type": "array", "items": {"type": "string", "minLength": 1}}, "coverage_paths": {"type": "array", "items": {"type": "string", "minLength": 1}}, "risk_labels": {"type": "array", "items": {"type": "string", "minLength": 1}}, "mandatory": {"type": "boolean"}, "timeout_seconds": {"type": "integer", "minimum": 1}, "estimated_duration_seconds": {"type": "integer", "minimum": 0}, "resource_group": {"type": "string"}}},
    "reviewedExclusion": {"type": "object", "additionalProperties": false, "required": ["unit_key", "reviewer", "reviewed_at", "rationale"], "properties": {"unit_key": {"type": "string", "pattern": "^\\S(?:.*\\S)?$"}, "reviewer": {"type": "string", "pattern": "^\\S(?:.*\\S)?$"}, "reviewed_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}, "rationale": {"type": "string", "pattern": "^\\S(?:.*\\S)?$"}}},
    "hardPathException": {"type": "object", "additionalProperties": false, "required": ["path", "rule", "reviewer", "reviewed_at", "rationale"], "description": "Reviewed, narrow exception to one hard full-suite rule (ADR 0019); rule names the escalation it covers, labels are never exceptable.", "properties": {"path": {"type": "string", "pattern": "^\\S(?:.*\\S)?$"}, "rule": {"enum": ["LOCKFILE_CHANGE", "MIGRATION_CHANGE", "PUBLIC_CONTRACT_CHANGE"]}, "reviewer": {"type": "string", "pattern": "^\\S(?:.*\\S)?$"}, "reviewed_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}, "rationale": {"type": "string", "pattern": "^\\S(?:.*\\S)?$"}}}
  }
}
