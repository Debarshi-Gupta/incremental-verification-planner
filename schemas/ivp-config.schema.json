{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ivp.dev/schemas/ivp-config.schema.json",
  "title": "IVP repository configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "repository", "analysis", "server", "execution", "modes", "selection", "safety", "adapters", "telemetry"],
  "properties": {
    "version": {"const": 1},
    "repository": {"type": "object", "additionalProperties": false, "required": ["slug", "default_branch"], "properties": {"slug": {"type": "string", "minLength": 1}, "default_branch": {"type": "string", "minLength": 1}}},
    "analysis": {"type": "object", "additionalProperties": false, "required": ["base_ref", "follow_renames", "include_untracked", "max_changed_files_for_selective_plan", "graph_staleness_minutes", "coverage_staleness_days", "require_clean_dependency_resolution"], "properties": {"base_ref": {"type": "string", "minLength": 1}, "follow_renames": {"type": "boolean"}, "include_untracked": {"type": "boolean"}, "max_changed_files_for_selective_plan": {"type": "integer", "minimum": 1}, "graph_staleness_minutes": {"type": "integer", "minimum": 1}, "coverage_staleness_days": {"type": "integer", "minimum": 1}, "require_clean_dependency_resolution": {"type": "boolean"}}},
    "server": {"type": "object", "additionalProperties": false, "required": ["endpoint", "connect_timeout_seconds", "request_timeout_seconds", "offline_policy"], "properties": {"endpoint": {"type": "string", "format": "uri"}, "connect_timeout_seconds": {"type": "integer", "minimum": 1}, "request_timeout_seconds": {"type": "integer", "minimum": 1}, "offline_policy": {"enum": ["FULL_SUITE_FALLBACK"]}}},
    "execution": {"type": "object", "additionalProperties": false, "required": ["full_suite_argv", "timeout_seconds", "max_output_bytes"], "properties": {"full_suite_argv": {"type": "array", "items": {"type": "string", "minLength": 1}}, "timeout_seconds": {"type": "integer", "minimum": 1}, "max_output_bytes": {"type": "integer", "minimum": 1024, "maximum": 67108864}}},
    "modes": {"type": "object", "additionalProperties": false, "required": ["default", "observe", "fast_feedback", "risk_based_ci"], "properties": {"default": {"enum": ["FULL", "OBSERVE", "FAST_FEEDBACK", "RISK_BASED_CI"]}, "observe": {"type": "object", "additionalProperties": false, "required": ["execute_full_suite", "selected_plan_only_report"], "properties": {"execute_full_suite": {"const": true}, "selected_plan_only_report": {"type": "boolean"}}}, "fast_feedback": {"type": "object", "additionalProperties": false, "required": ["final_ci_full_suite_required", "allow_selective_inner_loop"], "properties": {"final_ci_full_suite_required": {"const": true}, "allow_selective_inner_loop": {"type": "boolean"}}}, "risk_based_ci": {"type": "object", "additionalProperties": false, "required": ["enabled_by_organization_policy", "audit_sample_rate", "minimum_calibration_runs", "minimum_audit_runs"], "properties": {"enabled_by_organization_policy": {"type": "boolean"}, "audit_sample_rate": {"type": "number", "minimum": 0, "maximum": 1}, "minimum_calibration_runs": {"type": "integer", "minimum": 1}, "minimum_audit_runs": {"type": "integer", "minimum": 1}}}}},
    "selection": {"type": "object", "additionalProperties": false, "required": ["low_risk_max_score", "medium_risk_max_score", "low_risk_min_weighted_coverage", "medium_risk_min_weighted_coverage", "minimum_selection_confidence", "max_selective_estimated_runtime_fraction", "unknown_evidence_action", "non_deterministic_test_action", "if_no_tests_selected"], "properties": {"low_risk_max_score": {"type": "integer", "minimum": 0, "maximum": 100}, "medium_risk_max_score": {"type": "integer", "minimum": 0, "maximum": 100}, "low_risk_min_weighted_coverage": {"type": "number", "minimum": 0, "maximum": 1}, "medium_risk_min_weighted_coverage": {"type": "number", "minimum": 0, "maximum": 1}, "minimum_selection_confidence": {"type": "number", "minimum": 0, "maximum": 1}, "max_selective_estimated_runtime_fraction": {"type": "number", "minimum": 0, "maximum": 1}, "unknown_evidence_action": {"const": "FULL_SUITE"}, "non_deterministic_test_action": {"const": "INCLUDE_AND_LABEL"}, "if_no_tests_selected": {"const": "FULL_SUITE"}}},
    "safety": {"type": "object", "additionalProperties": false, "required": ["hard_full_suite_paths", "hard_full_suite_risk_labels", "always_run_check_ids", "audit"], "properties": {"hard_full_suite_paths": {"type": "array", "items": {"type": "string"}}, "hard_full_suite_risk_labels": {"type": "array", "items": {"type": "string"}}, "always_run_check_ids": {"type": "array", "items": {"type": "string"}}, "audit": {"type": "object", "additionalProperties": false, "required": ["enabled", "default_mode", "sample_rate", "minimum_audits_before_selective_ci", "quarantine_on_confirmed_miss", "quarantine_hours", "repeat_failed_test_count"], "properties": {"enabled": {"type": "boolean"}, "default_mode": {"enum": ["SHADOW", "AUDIT"]}, "sample_rate": {"type": "number", "minimum": 0, "maximum": 1}, "minimum_audits_before_selective_ci": {"type": "integer", "minimum": 1}, "quarantine_on_confirmed_miss": {"const": true}, "quarantine_hours": {"type": "integer", "minimum": 1}, "repeat_failed_test_count": {"type": "integer", "minimum": 1}}}}},
    "adapters": {"type": "object", "additionalProperties": false, "required": ["gradle", "maven", "bazel", "nx", "pytest", "jest", "generic"], "properties": {"gradle": {"$ref": "#/$defs/gradle"}, "maven": {"$ref": "#/$defs/maven"}, "bazel": {"$ref": "#/$defs/bazel"}, "nx": {"$ref": "#/$defs/nx"}, "pytest": {"$ref": "#/$defs/pytest"}, "jest": {"$ref": "#/$defs/jest"}, "generic": {"$ref": "#/$defs/generic"}}},
    "telemetry": {"type": "object", "additionalProperties": false, "required": ["enabled", "capture_raw_stdout", "capture_failure_excerpt", "max_excerpt_bytes", "retention_days"], "properties": {"enabled": {"type": "boolean"}, "capture_raw_stdout": {"const": false}, "capture_failure_excerpt": {"type": "boolean"}, "max_excerpt_bytes": {"type": "integer", "minimum": 0, "maximum": 8192}, "retention_days": {"type": "integer", "minimum": 1}}}
  },
  "$defs": {
    "gradle": {"type": "object", "additionalProperties": false, "required": ["enabled", "wrapper_required", "unit_test_tasks", "integration_test_tasks"], "properties": {"enabled": {"type": "boolean"}, "wrapper_required": {"type": "boolean"}, "unit_test_tasks": {"type": "array", "items": {"type": "string"}}, "integration_test_tasks": {"type": "array", "items": {"type": "string"}}}},
    "maven": {"type": "object", "additionalProperties": false, "required": ["enabled", "wrapper_preferred", "surefire_enabled", "failsafe_enabled"], "properties": {"enabled": {"type": "boolean"}, "wrapper_preferred": {"type": "boolean"}, "surefire_enabled": {"type": "boolean"}, "failsafe_enabled": {"type": "boolean"}}},
    "bazel": {"type": "object", "additionalProperties": false, "required": ["enabled", "use_configured_target_patterns"], "properties": {"enabled": {"type": "boolean"}, "use_configured_target_patterns": {"type": "boolean"}}},
    "nx": {"type": "object", "additionalProperties": false, "required": ["enabled", "test_target_names"], "properties": {"enabled": {"type": "boolean"}, "test_target_names": {"type": "array", "items": {"type": "string"}}}},
    "pytest": {"type": "object", "additionalProperties": false, "required": ["enabled", "config_file"], "properties": {"enabled": {"type": "boolean"}, "config_file": {"type": "string"}}},
    "jest": {"type": "object", "additionalProperties": false, "required": ["enabled", "config_discovery"], "properties": {"enabled": {"type": "boolean"}, "config_discovery": {"type": "boolean"}}},
    "generic": {"type": "object", "additionalProperties": false, "required": ["enabled", "test_units", "checks"], "properties": {"enabled": {"type": "boolean"}, "test_units": {"type": "array", "items": {"type": "object"}}, "checks": {"type": "array", "items": {"type": "object"}}}}
  }
}
